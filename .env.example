# Copy to .env and fill secrets. Never commit .env.

PORT=3000
DEV_MODE=1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:3000/oauth2/callback
# SPA URL after OAuth success (must match host you open in browser: localhost vs 127.0.0.1)
FRONTEND_ORIGIN=http://localhost:5174/

DATA_DIR=./data
# TOKEN_PATH defaults to ./data/token.json
SESSION_SECRET=change-me-to-a-long-random-string

# Optional Drive folder to treat as backup root
ROOT_FOLDER_ID=

# --- Download feature (yt-dlp → Google Drive) ---
# Path to yt-dlp executable. Leave empty to disable the download feature.
YTDLP_PATH=
# Optional proxy for yt-dlp (e.g. socks5://127.0.0.1:10808). Only used for sites that need it.
DOWNLOAD_PROXY=
# Path to Netscape-format cookie file for sites requiring auth (e.g. Bilibili).
# Use cmd/cookieconvert to convert Cookie Editor JSON exports.
DOWNLOAD_COOKIE_PATH=
# Directory for temporary download files (defaults to DATA_DIR/downloads).
DOWNLOAD_TMP_DIR=
