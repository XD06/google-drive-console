{
  "openapi": "3.1.0",
  "info": {
    "title": "Drive Backup Console — Agent API",
    "version": "1.0.0",
    "description": "Programmatic file API for AI agents and scripts. Authenticate with an API key via `Authorization: Bearer <token>` (or a browser session cookie for the UI). Read-only keys may call `read` operations; `readwrite` keys may also mutate. Keys act as the site owner against the server-side Google Drive token; scope limits what a key may do, not whose Drive it sees."
  },
  "servers": [{ "url": "/api/v1" }],
  "security": [{ "BearerAuth": [] }, { "CookieAuth": [] }],
  "tags": [
    { "name": "files", "description": "Browse and manipulate Drive files and folders" },
    { "name": "keys", "description": "Manage API keys (session-only; keys cannot manage keys)" },
    { "name": "meta", "description": "Discovery and account overview" },
    { "name": "uploads", "description": "Resumable chunked uploads into Drive" },
    { "name": "downloads", "description": "yt-dlp URL downloads: background jobs with pause/resume, auto-retry, dedupe cache and progress query" },
    { "name": "links", "description": "Revocable direct links (/d/{token}) that stream files through this server — no Google login needed" }
  ],
  "paths": {
    "/openapi.json": {
      "get": {
        "tags": ["meta"], "summary": "This OpenAPI document", "operationId": "getOpenAPI",
        "security": [], "responses": { "200": { "description": "OpenAPI 3.1 document" } }
      }
    },
    "/overview": {
      "get": {
        "tags": ["meta"], "summary": "Account and storage overview", "operationId": "getOverview",
        "x-required-scope": "read",
        "responses": { "200": { "description": "Overview" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/keys": {
      "get": {
        "tags": ["keys"], "summary": "List API keys (no secrets)", "operationId": "listKeys",
        "description": "Session-only. Returns key metadata; never returns tokens or hashes.",
        "responses": { "200": { "description": "Keys", "content": { "application/json": { "schema": { "type": "object", "properties": { "keys": { "type": "array", "items": { "$ref": "#/components/schemas/Key" } } } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      },
      "post": {
        "tags": ["keys"], "summary": "Create an API key", "operationId": "createKey",
        "description": "Session-only. The plaintext token is returned exactly once.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "scope": { "$ref": "#/components/schemas/Scope" } } } } } },
        "responses": { "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NewKey" } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/keys/{id}": {
      "delete": {
        "tags": ["keys"], "summary": "Revoke an API key", "operationId": "revokeKey",
        "description": "Session-only.",
        "parameters": [{ "$ref": "#/components/parameters/PathId" }],
        "responses": { "204": { "description": "Revoked" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/files": {
      "get": {
        "tags": ["files"], "summary": "List folder children", "operationId": "listFiles",
        "x-required-scope": "read",
        "parameters": [
          { "name": "folderId", "in": "query", "schema": { "type": "string" }, "description": "Folder id; defaults to the configured root" },
          { "name": "pageToken", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Page of items", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ListResult" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      },
      "post": {
        "tags": ["files"], "summary": "Create a file with text content", "operationId": "createFile",
        "x-required-scope": "readwrite",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "name": { "type": "string" }, "parentId": { "type": "string" }, "content": { "type": "string" }, "mimeType": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Created file", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FileItem" } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/files/search": {
      "get": {
        "tags": ["files"], "summary": "Search files by name", "operationId": "searchFiles",
        "x-required-scope": "read",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "scope", "in": "query", "schema": { "type": "string", "enum": ["folder", "drive"] } },
          { "name": "folderId", "in": "query", "schema": { "type": "string" } },
          { "name": "pageToken", "in": "query", "schema": { "type": "string" } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Search results", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ListResult" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/files/mkdir": {
      "post": {
        "tags": ["files"], "summary": "Create a folder", "operationId": "makeDir",
        "x-required-scope": "readwrite",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "parentId": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Folder", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FileItem" } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/files/{id}": {
      "patch": {
        "tags": ["files"], "summary": "Update name and/or description", "operationId": "updateFile",
        "x-required-scope": "readwrite",
        "description": "At least one of name/description is required. An empty description clears it. Folder descriptions help agents understand a folder's purpose and are returned by list/search.",
        "parameters": [{ "$ref": "#/components/parameters/PathId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "name": { "type": "string" }, "description": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Updated item", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FileItem" } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" } }
      },
      "delete": {
        "tags": ["files"], "summary": "Move a file to trash", "operationId": "trashFile",
        "x-required-scope": "readwrite",
        "parameters": [{ "$ref": "#/components/parameters/PathId" }],
        "responses": { "204": { "description": "Trashed" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/files/{id}/content": {
      "get": {
        "tags": ["files"], "summary": "Read text file content", "operationId": "getContent",
        "x-required-scope": "read",
        "parameters": [{ "$ref": "#/components/parameters/PathId" }],
        "responses": { "200": { "description": "File content" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" } }
      },
      "put": {
        "tags": ["files"], "summary": "Overwrite text file content", "operationId": "putContent",
        "x-required-scope": "readwrite",
        "parameters": [{ "$ref": "#/components/parameters/PathId" }],
        "requestBody": { "required": true, "content": { "text/plain": { "schema": { "type": "string" } } } },
        "responses": { "200": { "description": "Updated" }, "403": { "$ref": "#/components/responses/Forbidden" }, "413": { "$ref": "#/components/responses/TooLarge" } }
      }
    },
    "/files/{id}/download": {
      "get": {
        "tags": ["files"], "summary": "Download a binary file", "operationId": "downloadFile",
        "x-required-scope": "read",
        "parameters": [{ "$ref": "#/components/parameters/PathId" }],
        "responses": { "200": { "description": "Binary stream" }, "206": { "description": "Partial content" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/files/{id}/move": {
      "post": {
        "tags": ["files"], "summary": "Move to another folder", "operationId": "moveFile",
        "x-required-scope": "readwrite",
        "parameters": [{ "$ref": "#/components/parameters/PathId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["parentId"], "properties": { "parentId": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Moved item", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FileItem" } } } }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/files/{id}/copy": {
      "post": {
        "tags": ["files"], "summary": "Copy a file", "operationId": "copyFile",
        "x-required-scope": "readwrite",
        "parameters": [{ "$ref": "#/components/parameters/PathId" }],
        "responses": { "200": { "description": "Copied item", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FileItem" } } } }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/files/{id}/revisions": {
      "get": {
        "tags": ["files"], "summary": "List file revisions", "operationId": "listRevisions",
        "x-required-scope": "read",
        "parameters": [{ "$ref": "#/components/parameters/PathId" }],
        "responses": { "200": { "description": "Revisions" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/files/{id}/link": {
      "post": {
        "tags": ["links"], "summary": "Create (or get) a direct link", "operationId": "createLink",
        "x-required-scope": "readwrite",
        "description": "Idempotent: one link per file. Returns a public URL `{origin}/d/{token}` that streams the file through this server with Range support (video seeking, resumable fetch). Append `?dl=1` to force a download. Folders cannot be linked.",
        "parameters": [{ "$ref": "#/components/parameters/PathId" }],
        "responses": { "201": { "description": "Direct link", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DirectLink" } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/files/{id}/links": {
      "get": {
        "tags": ["links"], "summary": "List direct links for a file", "operationId": "listFileLinks",
        "x-required-scope": "read",
        "parameters": [{ "$ref": "#/components/parameters/PathId" }],
        "responses": { "200": { "description": "Links", "content": { "application/json": { "schema": { "type": "object", "properties": { "links": { "type": "array", "items": { "$ref": "#/components/schemas/DirectLink" } } } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/links": {
      "get": {
        "tags": ["links"], "summary": "List all direct links", "operationId": "listLinks",
        "x-required-scope": "read",
        "responses": { "200": { "description": "Links", "content": { "application/json": { "schema": { "type": "object", "properties": { "links": { "type": "array", "items": { "$ref": "#/components/schemas/DirectLink" } } } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/links/{token}": {
      "delete": {
        "tags": ["links"], "summary": "Revoke a direct link", "operationId": "revokeLink",
        "x-required-scope": "readwrite",
        "description": "Idempotent — revoking an unknown token still returns 200 with `revoked: false`. The public URL stops working immediately.",
        "parameters": [{ "name": "token", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Revocation result" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/uploads": {
      "post": {
        "tags": ["uploads"], "summary": "Start a resumable upload session", "operationId": "createUpload",
        "x-required-scope": "readwrite",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["name", "size"], "properties": { "name": { "type": "string" }, "size": { "type": "integer" }, "parentId": { "type": "string" }, "mimeType": { "type": "string" } } } } } },
        "responses": { "201": { "description": "Session created; send chunks to the returned URL", "content": { "application/json": { "schema": { "type": "object", "properties": { "uploadId": { "type": "string" }, "status": { "type": "string" }, "total": { "type": "integer" }, "chunkSize": { "type": "integer" } } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/uploads/{id}": {
      "get": {
        "tags": ["uploads"], "summary": "Query upload progress", "operationId": "uploadStatus",
        "x-required-scope": "read",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Upload status with sent/total bytes" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/uploads/{id}/chunk": {
      "put": {
        "tags": ["uploads"], "summary": "Append a chunk", "operationId": "uploadChunk",
        "x-required-scope": "readwrite",
        "description": "Raw bytes as body; optional Content-Range header for resuming at an offset.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Chunk accepted (nextByte / complete)" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/uploads/{id}/cancel": {
      "post": {
        "tags": ["uploads"], "summary": "Cancel an upload session", "operationId": "cancelUpload",
        "x-required-scope": "readwrite",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Cancelled" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/downloads": {
      "get": {
        "tags": ["downloads"], "summary": "List download jobs", "operationId": "listDownloads",
        "x-required-scope": "read",
        "responses": { "200": { "description": "Jobs (newest first)", "content": { "application/json": { "schema": { "type": "object", "properties": { "jobs": { "type": "array", "items": { "$ref": "#/components/schemas/DownloadJob" } } } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      },
      "post": {
        "tags": ["downloads"], "summary": "Create a background download", "operationId": "createDownload",
        "x-required-scope": "readwrite",
        "description": "The job runs server-side and survives closing the browser. Dedupe: when the same URL is already active the existing job is returned with HTTP 200 and `dedupe: \"active\"`; a URL completed within DOWNLOAD_CACHE_TTL (default 24h) returns `dedupe: \"completed\"` with its `driveFileId` instead of re-downloading.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string" }, "parentId": { "type": "string", "description": "Destination folder id or name; defaults to root" } } } } } },
        "responses": {
          "201": { "description": "New job created", "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string" }, "url": { "type": "string" }, "status": { "type": "string" }, "title": { "type": ["string", "null"] } } } } } },
          "200": { "description": "Existing job returned (dedupe)", "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string" }, "url": { "type": "string" }, "status": { "type": "string" }, "title": { "type": ["string", "null"] }, "dedupe": { "type": "string", "enum": ["active", "completed"] }, "driveFileId": { "type": "string" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "tags": ["downloads"], "summary": "Clear all terminal jobs", "operationId": "clearDownloads",
        "x-required-scope": "readwrite",
        "responses": { "200": { "description": "Cleared" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/downloads/{id}": {
      "get": {
        "tags": ["downloads"], "summary": "Query download progress", "operationId": "downloadStatus",
        "x-required-scope": "read",
        "description": "Poll this while the job is pending/resolving/downloading/uploading. Status flow: pending → resolving → downloading → uploading → completed; paused and failed are side states.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Job", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DownloadJob" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" } }
      },
      "delete": {
        "tags": ["downloads"], "summary": "Delete a terminal job record", "operationId": "deleteDownload",
        "x-required-scope": "readwrite",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Deleted" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/downloads/{id}/pause": {
      "post": {
        "tags": ["downloads"], "summary": "Pause a job", "operationId": "pauseDownload",
        "x-required-scope": "readwrite",
        "description": "Kills the yt-dlp subprocess and keeps the .part file. Allowed while pending/resolving/downloading; uploads cannot be paused.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Paused" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/downloads/{id}/resume": {
      "post": {
        "tags": ["downloads"], "summary": "Resume a paused job", "operationId": "resumeDownload",
        "x-required-scope": "readwrite",
        "description": "Continues from the .part file — only the missing tail is fetched.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "202": { "description": "Resuming" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/downloads/{id}/cancel": {
      "post": {
        "tags": ["downloads"], "summary": "Cancel a job", "operationId": "cancelDownload",
        "x-required-scope": "readwrite",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Cancelled" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/downloads/{id}/retry-upload": {
      "post": {
        "tags": ["downloads"], "summary": "Retry only the Drive upload of a failed job", "operationId": "retryDownloadUpload",
        "x-required-scope": "readwrite",
        "description": "Reuses the already-downloaded local file; no re-download.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "202": { "description": "Retrying" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": { "type": "http", "scheme": "bearer", "description": "API key token: `Authorization: Bearer dbc_...`" },
      "CookieAuth": { "type": "apiKey", "in": "cookie", "name": "dbc_session", "description": "Browser session cookie (UI). Full read-write." }
    },
    "parameters": {
      "PathId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Drive file/folder id" }
    },
    "schemas": {
      "Scope": { "type": "string", "enum": ["read", "readwrite"], "default": "read" },
      "Error": { "type": "object", "properties": { "error": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" } } } } },
      "FileItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "mimeType": { "type": "string" },
          "size": { "type": ["integer", "null"] },
          "modifiedTime": { "type": "string" },
          "isFolder": { "type": "boolean" },
          "description": { "type": "string", "description": "Drive native description (folder/file blurb)" },
          "thumbnailUrl": { "type": "string" }
        }
      },
      "ListResult": {
        "type": "object",
        "properties": {
          "folderId": { "type": "string" },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/FileItem" } },
          "nextPageToken": { "type": "string" }
        }
      },
      "Key": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "hint": { "type": "string" },
          "scope": { "$ref": "#/components/schemas/Scope" },
          "createdAt": { "type": "string" },
          "lastUsedAt": { "type": "string" },
          "revoked": { "type": "boolean" }
        }
      },
      "NewKey": {
        "allOf": [
          { "$ref": "#/components/schemas/Key" },
          { "type": "object", "properties": { "token": { "type": "string", "description": "Plaintext token, shown once" } } }
        ]
      },
      "DirectLink": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "url": { "type": "string", "description": "Absolute public URL served at the server root: {origin}/d/{token}" },
          "fileId": { "type": "string" },
          "name": { "type": "string" },
          "createdAt": { "type": "string" }
        }
      },
      "DownloadJob": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string" },
          "parentId": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["pending", "resolving", "downloading", "uploading", "paused", "completed", "failed", "cancelled"] },
          "progress": { "type": "number", "description": "0-100" },
          "speed": { "type": ["string", "null"] },
          "eta": { "type": ["string", "null"] },
          "downloaded": { "type": "integer" },
          "total": { "type": "integer" },
          "title": { "type": ["string", "null"] },
          "thumbnail": { "type": ["string", "null"] },
          "extractor": { "type": ["string", "null"] },
          "uploader": { "type": ["string", "null"] },
          "duration": { "type": "integer" },
          "ext": { "type": ["string", "null"] },
          "fileName": { "type": ["string", "null"], "description": "Local temp file path (set when download finished but upload failed — retry-upload can reuse it)" },
          "driveFileId": { "type": ["string", "null"], "description": "Set once completed — the Drive file produced by this job" },
          "error": { "type": ["string", "null"] },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" }
        }
      }
    },
    "responses": {
      "BadRequest": { "description": "Invalid request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
